{
  "name": "herbisense-api",
  "version": "1.0.0",
  "description": "Herbisense API server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "node src/database/create-local-db.js",
    "db:migrate": "node src/database/migrate.js",
    "db:setup": "npm run db:create && npm run db:migrate",
    "migration:generate": "node src/database/generate-migration.js",
